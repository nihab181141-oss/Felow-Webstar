rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nihabalmahjabin@gmail.com' &&
        request.auth.token.email_verified == true
      );
    }

    // Avatars: Public read, verified owner write (images < 5MB)
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isVerifiedOwner(userId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Verification documents (NID, student card, certificates): Strictly private (images or PDF < 10MB)
    match /verifications/{tutorId}/{fileName} {
      allow read: if isOwner(tutorId) || isAdmin();
      allow write: if isVerifiedOwner(tutorId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
